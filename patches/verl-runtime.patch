+def _materialize_dtensor_on_cpu(param: DTensor) -> torch.Tensor:
+    """Rebuild a one-dimensional FSDP DTensor using CPU Gloo collectives.
+
+    Calling ``DTensor.full_tensor()`` uses the CUDA device mesh and crashes on
+    hosts where NCCL/NVML is unavailable. Conversely, moving the DTensor to CPU
+    before ``full_tensor()`` leaves its mesh/device metadata inconsistent and
+    can return zero-filled tensors. Gather the local CPU shards explicitly.
+    """
+
+    placements = tuple(param.placements)
+    if len(placements) != 1:
+        raise RuntimeError(f"Only one-dimensional FSDP meshes are supported, got {placements}")
+
+    placement = placements[0]
+    local = param.to_local().detach().to(dtype=torch.bfloat16, device="cpu").contiguous()
+    if isinstance(placement, Replicate):
+        return local
+    if not isinstance(placement, Shard):
+        raise RuntimeError(f"Unsupported DTensor placement for weight sync: {placement}")
+
+    group = param.device_mesh.get_group()
+    world_size = torch.distributed.get_world_size(group)
+    local_shapes: list[tuple[int, ...] | None] = [None] * world_size
+    torch.distributed.all_gather_object(local_shapes, tuple(local.shape), group=group)
+    assert all(shape is not None for shape in local_shapes)
+
+    max_numel = max(torch.Size(shape).numel() for shape in local_shapes if shape is not None)
+    padded = torch.zeros(max_numel, dtype=local.dtype, device="cpu")
+    padded[: local.numel()].copy_(local.reshape(-1))
+    gathered = [torch.empty_like(padded) for _ in range(world_size)]
+    torch.distributed.all_gather(gathered, padded, group=group)
+
+    shards = [
+        tensor[: torch.Size(shape).numel()].view(shape)
+        for tensor, shape in zip(gathered, local_shapes, strict=True)
+        if shape is not None
+    ]
+    full = torch.cat(shards, dim=placement.dim)
+    # Uneven sharding may pad the final rank. Trim back to the global shape.
+    slices = tuple(slice(0, size) for size in param.shape)
+    return full[slices].contiguous()
