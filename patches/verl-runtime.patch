+def _rebuild_nested_samples(samples: list[torch.Tensor], ragged_idx: int | None = None) -> torch.Tensor:
+    """Rebuild samples without losing a trailing jagged dimension.
+
+    ``as_nested_tensor([sample])`` cannot infer whether a singleton matrix
+    shaped ``(4, seq_len)`` is ragged on its first or second axis.  mRoPE
+    position ids require the latter.  Build that layout explicitly and cache
+    the true min/max sequence lengths so padding and serialization preserve
+    all tokens.
+    """
+    if samples and samples[0].dim() == 2 and ragged_idx == 2:
+        lengths = [sample.shape[-1] for sample in samples]
+        values = torch.cat(samples, dim=-1)
+        offsets = torch.tensor(
+            [0, *np.cumsum(lengths).tolist()], dtype=torch.int64, device=values.device
+        )
+        return torch.nested.nested_tensor_from_jagged(
+            values,
+            offsets=offsets,
+            jagged_dim=2,
+            min_seqlen=min(lengths),
+            max_seqlen=max(lengths),
+        )
+    return torch.nested.as_nested_tensor(samples, layout=torch.jagged)
+
